# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio (RNF-06).

# --- PostgreSQL ---
# Rol administrador/propietario: crea esquemas, carga datos y escribe la bitácora.
DATABASE_URL_ADMIN=postgresql://postgres:CAMBIAR@localhost:5432/uchumayo
# Rol de solo lectura que usa el asistente (C1/C2 y herramientas de C3).
ASISTENTE_RO_PASSWORD=CAMBIAR_RO
DATABASE_URL_RO=postgresql://asistente_ro:CAMBIAR_RO@localhost:5432/uchumayo

# --- Seudonimización de RUC de personas naturales (Ley 29733, RNF-07) ---
# Clave secreta para HMAC-SHA256. Generar una vez con:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Debe ser LA MISMA para ambos integrantes; si cambia, cambian todos los seudónimos.
SEUDONIMO_CLAVE=CAMBIAR

# --- API del asistente (S4) ---
# Clave para firmar las sesiones (mínimo 32 caracteres). Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_SECRETO=CAMBIAR
# Solo para Docker: contraseña del usuario postgres del contenedor de la base.
POSTGRES_PASSWORD=postgres

# --- Modelo de lenguaje ---
GROQ_API_KEY=
# Cerebras: proveedor usado en la evaluación (gpt-oss-120b). DeepInfra: alternativa de pago por consumo.
# (Sin comentarios al final de la línea: Docker los tomaría como parte del valor.)
CEREBRAS_API_KEY=
DEEPINFRA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
